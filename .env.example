# GEMINI_API_KEY: Optional for AI-assisted category disambiguation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Authorized Partner / Affiliate Data Feed Endpoints
# Leave empty if you do not have official partner API credentials;
# platforms without configured feeds will honestly report "Data source unavailable"
# and provide verified external search links.
BLINKIT_PARTNER_FEED_URL=""
BLINKIT_PARTNER_API_KEY=""

ZEPTO_PARTNER_FEED_URL=""
ZEPTO_PARTNER_API_KEY=""

FLIPKART_AFFILIATE_API_URL=""
FLIPKART_AFFILIATE_ID=""
FLIPKART_AFFILIATE_TOKEN=""

AMAZON_PAAPI_ENDPOINT=""
AMAZON_PAAPI_ACCESS_KEY=""
AMAZON_PAAPI_SECRET_KEY=""
